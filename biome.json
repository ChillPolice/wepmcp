{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "public/**",
      "*.json",
      "*.md",
      "!!**/.angular",
      "!!**/dist",
      "!!**/node_modules"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.html"],
      "linter": {
        "enabled": false
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit"
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  }
}
